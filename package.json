{
  "name": "hideko-code-block",
  "version": "1.0.0",
  "description": "Ultra-lightweight High-Performance Code Syntax Highlighter with Adaptive Virtual Scroll & CLI Tool",
  "type": "module",
  "bin": {
    "hideko": "./bin/hideko.js"
  },
  "main": "./dist/hideko-code-block.umd.js",
  "module": "./dist/hideko-code-block.js",
  "unpkg": "./dist/hideko-code-block.min.js",
  "jsdelivr": "./dist/hideko-code-block.min.js",
  "exports": {
    ".": {
      "import": "./dist/hideko-code-block.js",
      "require": "./dist/hideko-code-block.umd.js",
      "default": "./dist/hideko-code-block.umd.js"
    },
    "./node": "./dist/node/index.js",
    "./style.css": "./dist/style.css",
    "./style.min.css": "./dist/style.min.css",
    "./languages/*": "./dist/languages/*.js",
    "./languages": "./dist/languages/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-dist.js",
    "preview": "vite preview",
    "test": "node test/runner.js",
    "convert": "node bin/hideko.js convert"
  },
  "keywords": [
    "syntax-highlighter",
    "code-block",
    "code-highlighter",
    "virtual-scroll",
    "cli",
    "monarch",
    "markdown-highlight",
    "fast"
  ],
  "author": "Chin6700x <Chin6700X@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^5.4.14"
  }
}
